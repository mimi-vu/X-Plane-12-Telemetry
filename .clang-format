# JSF Air Vehicle C++ Coding Standards — clang-format profile
# Derived from LLVM base with JSF/MISRA-aligned overrides
---
Language:        Cpp
BasedOnStyle:    LLVM

# Indentation
IndentWidth:              4
TabWidth:                 4
UseTab:                   Never
ContinuationIndentWidth:  4

# Braces — Allman style mandated by JSF §AV Rule 59
BreakBeforeBraces:        Allman

# Column limit — JSF §AV Rule 14: 132 chars max
ColumnLimit:              132

# Includes
SortIncludes:             CaseSensitive
IncludeBlocks:            Regroup

# Pointer/reference alignment
PointerAlignment:         Left
ReferenceAlignment:       Left

# One statement per line — JSF §AV Rule 10
AllowShortFunctionsOnASingleLine:   None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine:        false

# Trailing commas / spaces
SpaceBeforeParens:     ControlStatements
SpaceAfterCStyleCast:  true
SpacesInAngles:        false

# Namespace indentation — no indent for top-level namespaces
NamespaceIndentation:  None

# Access modifiers
AccessModifierOffset:  -4

# Max empty lines
MaxEmptyLinesToKeep:   2
